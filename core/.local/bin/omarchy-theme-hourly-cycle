#!/bin/bash

# omarchy:summary=Hourly background and dynamic theme cycler (only if aether theme is active)

CURRENT_THEME=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)

# Only cycle if the active theme is aether (never alter static themes)
if [[ "$CURRENT_THEME" != "aether" ]]; then
  exit 0
fi

WALLPAPERS_DIR="$HOME/Pictures/Wallpapers"
CURRENT_BG=$(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null)

# Pick a random wallpaper from the collection (excluding the current one)
mapfile -t available_wallpapers < <(
  find "$WALLPAPERS_DIR" -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) | grep -vF "$CURRENT_BG"
)

if (( ${#available_wallpapers[@]} == 0 )); then
  exit 0
fi

NEW_WALLPAPER=$(shuf -n 1 -e "${available_wallpapers[@]}")

# Apply the new wallpaper and dynamic theme recolor
/home/jmvp/.local/bin/omarchy-theme-bg-set "$NEW_WALLPAPER"

# Rotate the background switcher pool with a fresh shuffle of 35 pictures
/home/jmvp/.local/bin/omarchy-theme-shuffle-backgrounds >/dev/null 2>&1 &
