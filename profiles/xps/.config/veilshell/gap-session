#!/usr/bin/env bash
# Companion to veilshell-gaps.service. Change only a runtime option, not Lua files.
set -euo pipefail
umask 077

runtime=${XDG_RUNTIME_DIR:?Expected a graphical user session}
state="${RUNTIME_DIRECTORY:?Run through veilshell-gaps.service}/restore-resize"
veilctl="$HOME/Projects/veilshell/target/release/veilctl"
output=eDP-1

die() {
    printf 'VeilShell gaps: %s\n' "$*" >&2
    exit 1
}

hypr() {
    timeout 1s hyprctl -i "$signature" "$@"
}

resize_setting() {
    hypr -j getoption general:resize_on_border | jq -er '
        select(.option == "general:resize_on_border")
        | if (.bool | type) == "boolean" then (.bool | tostring)
          elif .int == 0 or .int == 1 then (.int == 1 | tostring)
          else error("unknown resize setting")
          end'
}

set_resize() {
    [[ $1 == true || $1 == false ]] &&
        [[ $(hypr eval "hl.config({ general = { resize_on_border = $1 } })") == ok ]] &&
        [[ $(resize_setting) == "$1" ]]
}

require_session() {
    signature=${HYPRLAND_INSTANCE_SIGNATURE:-}
    [[ $signature =~ ^[[:alnum:]_-]+$ && -n ${WAYLAND_DISPLAY:-} &&
       -n ${OMARCHY_PATH:-} && -r "$OMARCHY_PATH/default/hypr/bootstrap.lua" ]] ||
        die 'No Omarchy/Hyprland session in the service environment.'
    local instance="$runtime/hypr/$signature" display=$WAYLAND_DISPLAY
    [[ $display == /* ]] || display="$runtime/$display"
    [[ -S $display && -O $display && -S $instance/.socket.sock &&
       -O $instance/.socket.sock && -r $instance/hyprland.lock &&
       $(sed -n '2p' "$instance/hyprland.lock") == "${display##*/}" ]] ||
        die 'Hyprland IPC does not match the Wayland display.'
}

gpu_status() {
    [[ -S ${VEILSHELL_SOCKET:?} ]] || return 1
    status=$(timeout .5s "$veilctl" status 2>/dev/null) || return 1
    local daemon
    daemon=$(grep -m1 '^  daemon     : running (' <<<"$status") || return 1
    [[ $daemon == *"visible: true, output: $output "* &&
       $daemon == *'renderer: wgpu-sdf ('* && $daemon != *', Cpu)'* ]]
}

case ${1:-} in
    preflight)
        require_session
        [[ -x $veilctl ]] || die 'Missing the built veilctl binary.'
        if pgrep -u "$UID" -x veilshell >/dev/null; then
            die 'Another VeilShell instance is already running.'
        fi
        hypr -j monitors | jq -e --arg output "$output" 'any(.[]; .name == $output)' >/dev/null ||
            die "Touchscreen output $output is unavailable."
        hypr -j devices | jq -e '(.touch // []) | length > 0' >/dev/null ||
            die 'No touchscreen found.'
        ;;
    arm)
        require_session
        # Leave resizing alone if startup never reaches a working GPU session.
        deadline=$((SECONDS + 8))
        until gpu_status; do
            (( SECONDS < deadline )) || die 'The GPU-backed overlay did not become ready.'
            sleep .1
        done
        before=$(resize_setting)
        if [[ $before == true ]]; then
            # Write the original instance before changing its setting. StopPost
            # also runs after a failed startup or a killed VeilShell process.
            printf '%s\n' "$signature" >"$state"
            set_resize false || die 'Could not release the native resize area.'
        fi
        deadline=$((SECONDS + 5))
        while (( SECONDS < deadline )); do
            if gpu_status &&
                grep -Eq '^  overlay gaps: (top [1-9][0-9]*px, bottom [0-9]+px|top 0px, bottom [1-9][0-9]*px) \(logical\)$' <<<"$status"; then
                grep -E 'daemon     :|overlay gaps:' <<<"$status"
                exit 0
            fi
            sleep .1
        done
        die 'No gap strips armed; restoring the previous resize policy.'
        ;;
    restore)
        [[ -f $state ]] || exit 0
        IFS= read -r signature <"$state"
        [[ $signature =~ ^[[:alnum:]_-]+$ ]] || die 'Invalid restore marker.'
        # Never restore into a different session, including after logout.
        deadline=$((SECONDS + 6))
        while (( SECONDS < deadline )); do
            [[ -S $runtime/hypr/$signature/.socket.sock ]] || exit 0
            if [[ $(resize_setting) == true ]] || set_resize true; then
                rm -- "$state"
                printf 'Restored native border resizing.\n'
                exit 0
            fi
            sleep .2
        done
        die 'Could not restore native border resizing in the starting session.'
        ;;
    *) die 'Expected preflight, arm, or restore.' ;;
esac
