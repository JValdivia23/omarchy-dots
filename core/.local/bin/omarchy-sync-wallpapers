#!/bin/bash
set -eo pipefail

# omarchy:summary=Download/sync JValdivia23/walls and index it for omarchy-aether
# omarchy:args=[--force] [--no-warm]

WALLPAPERS_DIR="$HOME/Pictures/Wallpapers"
mkdir -p "$WALLPAPERS_DIR"

WALLS_REPO="${WALLS_REPO:-https://github.com/JValdivia23/walls.git}"
FALLBACK_REPO="https://github.com/dharmx/walls.git"
TARGET_DIR="$WALLPAPERS_DIR/walls"
FORCE=false
DO_WARM=true

for arg in "$@"; do
    case "$arg" in
        --force) FORCE=true ;;
        --no-warm) DO_WARM=false ;;
    esac
done

echo "======================================================="
echo "       🖼️  Omarchy Wallpaper Collection Sync          "
echo "======================================================="
echo "Target directory: $TARGET_DIR"

if [ -d "$TARGET_DIR/.git" ] && [ "$FORCE" = false ]; then
    echo "--> Existing git repository detected. Fetching latest updates..."
    git -C "$TARGET_DIR" pull --depth 1 || true
elif [ -d "$TARGET_DIR" ] && [ "$FORCE" = false ]; then
    echo "--> Wallpaper directory already exists ($TARGET_DIR)."
    echo "    To re-clone from GitHub, pass --force."
else
    if [ "$FORCE" = true ] && [ -d "$TARGET_DIR" ]; then
        echo "--> Removing existing directory due to --force..."
        rm -rf "$TARGET_DIR"
    fi

    echo "--> Cloning wallpaper collection from $WALLS_REPO (shallow depth 1)..."
    if ! git clone --depth 1 --no-tags "$WALLS_REPO" "$TARGET_DIR" 2>/dev/null; then
        echo "    Notice: $WALLS_REPO was unreachable. Falling back to upstream $FALLBACK_REPO..."
        git clone --depth 1 --no-tags "$FALLBACK_REPO" "$TARGET_DIR"
    fi
fi

if command -v omarchy-aether &>/dev/null && [ -d "$TARGET_DIR" ]; then
    echo "--> Indexing wallpaper collection for omarchy-aether..."
    omarchy-aether index "$TARGET_DIR" --json || true

    if omarchy-aether prepare --help &>/dev/null; then
        echo "--> Preparing Aether wallpaper carousel (35 candidates)..."
        omarchy-aether prepare --count 35 --preload --json 2>/dev/null || \
            omarchy-aether prepare --count 35 --json || true
    fi

    if [ ! -f "$HOME/.config/omarchy/themes/aether/colors.toml" ] || [ ! -f "$HOME/.config/omarchy/themes/aether/preview.png" ]; then
        SEED_IMG="$TARGET_DIR/aerial/a_aerial_view_of_a_snowy_mountain_range.jpg"
        if [ ! -f "$SEED_IMG" ]; then
            SEED_IMG="$(find "$TARGET_DIR" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | head -n 1)"
        fi
        if [ -n "$SEED_IMG" ] && [ -f "$SEED_IMG" ]; then
            echo "--> Staging Aether theme from $(basename "$SEED_IMG")..."
            omarchy-aether apply --image "$SEED_IMG" --stage-only --json || true
        fi
    fi

    if [ "$DO_WARM" = true ]; then
        echo "--> Warming Aether thumbnail cache in background (Nice=19)..."
        if command -v systemd-run &>/dev/null && systemctl --user status &>/dev/null; then
            if systemctl --user is-active --quiet omarchy-aether-warm.service 2>/dev/null; then
                echo "    omarchy-aether-warm.service is already running."
            else
                systemctl --user reset-failed omarchy-aether-warm.service 2>/dev/null || true
                systemd-run --user --unit=omarchy-aether-warm -p Nice=19 omarchy-aether warm --json || true
            fi
        else
            nohup nice -n 19 omarchy-aether warm --json >/dev/null 2>&1 &
        fi
    fi
fi

COUNT=$(find "$TARGET_DIR" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) 2>/dev/null | wc -l)
echo "-------------------------------------------------------"
echo "✅ Synchronization complete! Wallpapers in $TARGET_DIR: $COUNT"
echo "   Select Aether via Omarchy Menu > Appearance > Theme > Aether,"
echo "   and pick wallpapers via Omarchy Menu > Appearance > Background."
echo "======================================================="
