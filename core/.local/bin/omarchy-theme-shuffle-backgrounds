#!/bin/bash

# omarchy:summary=Shuffle a random pool of 35 wallpapers from collection into aether backgrounds and pre-cache them

POOL_DIR="$HOME/.config/omarchy/backgrounds/aether"
WALLPAPERS_DIR="$HOME/Pictures/Wallpapers"

mkdir -p "$POOL_DIR"
rm -f "$POOL_DIR"/*

# Find all wallpapers and pick 35 at random
mapfile -t selected_images < <(
  find "$WALLPAPERS_DIR" -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) | shuf -n 35
)

for img in "${selected_images[@]}"; do
  [[ -f "$img" ]] || continue
  name=$(basename "$img")
  # Handle potential filename collisions across subfolders by prefixing folder name if needed
  if [[ -e "$POOL_DIR/$name" ]]; then
    parent=$(basename "$(dirname "$img")")
    name="${parent}_${name}"
  fi
  ln -sf "$img" "$POOL_DIR/$name"
done

# Pre-cache thumbnails and preload into Quickshell
omarchy-theme-bg-cache >/dev/null 2>&1 &
