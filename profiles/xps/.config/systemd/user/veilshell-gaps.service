[Unit]
Description=VeilShell GPU touchscreen gestures on the XPS
Requisite=wayland-session@hyprland.desktop.target
After=wayland-session@hyprland.desktop.target wayland-session-waitenv.service
PartOf=wayland-session@hyprland.desktop.target
ConditionEnvironment=OMARCHY_PATH
ConditionFileIsExecutable=%h/Projects/veilshell/target/release/veilshell

[Service]
Type=exec
RuntimeDirectory=veilshell-gaps
RuntimeDirectoryMode=0700
Environment=VEILSHELL_SOCKET=%t/veilshell-gaps/control.sock
UnsetEnvironment=WAYLAND_SOCKET
ExecStartPre=/usr/bin/bash %h/.config/veilshell/gap-session preflight
ExecStart=%h/Projects/veilshell/target/release/veilshell --policy tablet --overlay-gap-gestures --osk manual --output eDP-1 --renderer wgpu
ExecStartPost=/usr/bin/bash %h/.config/veilshell/gap-session arm
ExecStopPost=/usr/bin/bash %h/.config/veilshell/gap-session restore
TimeoutStartSec=20s
TimeoutStopSec=10s

[Install]
WantedBy=wayland-session@hyprland.desktop.target
