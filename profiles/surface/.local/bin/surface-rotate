#!/usr/bin/env bash
# surface-rotate — Fast display transform rotation for Surface Book 3 eDP-1
set -euo pipefail

cur=$(hyprctl monitors -j | jq -r '.[] | select(.name == "eDP-1") | .transform // 0')
case "$cur" in
    0) nxt=1 ;; # 90 deg (portrait)
    1) nxt=3 ;; # 270 deg (flipped portrait)
    *) nxt=0 ;; # 0 deg (landscape)
esac

hyprctl keyword monitor "eDP-1,preferred,auto,2,$nxt" >/dev/null
omarchy notification send "Display Rotation" "eDP-1 transform: $nxt"
