#!/usr/bin/env python3
import os
import sys
import hashlib
import subprocess
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

CACHE_DIR = Path(os.path.expanduser("~/.cache/omarchy/image-selector"))
CACHE_DIR.mkdir(parents=True, exist_ok=True)
INDEX_FILE = CACHE_DIR / "index.tsv"
WALLPAPERS_DIR = Path(os.path.expanduser("~/Pictures/Wallpapers"))

# Load existing index
index = {}
if INDEX_FILE.exists():
    with open(INDEX_FILE, "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            parts = line.rstrip("\n").split("\t")
            if len(parts) >= 3:
                index[(parts[0], parts[1])] = parts[2]

# Find all images
valid_exts = {".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp"}
image_files = []
for root, _, files in os.walk(WALLPAPERS_DIR):
    for file in files:
        ext = os.path.splitext(file)[1].lower()
        if ext in valid_exts:
            image_files.append(os.path.join(root, file))

print(f"Total wallpapers found: {len(image_files)}")

new_index_entries = []

def process_image(img_path):
    try:
        st = os.stat(img_path)
        sig = f"{st.st_size}:{int(st.st_mtime)}"
    except Exception:
        return None

    h = index.get((img_path, sig))
    if not h:
        raw = f"{img_path}\t{sig}".encode("utf-8")
        h = hashlib.md5(raw).hexdigest()
        new_index_entries.append(f"{img_path}\t{sig}\t{h}\n")

    thumb_path = CACHE_DIR / f"{h}.jpg"
    if not thumb_path.exists():
        tmp_path = CACHE_DIR / f"{h}.{os.getpid()}.jpg"
        cmd = [
            "vipsthumbnail", img_path,
            "--size", "1536x864",
            "--smartcrop=centre",
            f"--path={tmp_path}[Q=82,strip]"
        ]
        try:
            env = os.environ.copy()
            env["VIPS_CONCURRENCY"] = "1"
            subprocess.run(cmd, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
            if tmp_path.exists():
                os.replace(tmp_path, thumb_path)
        except Exception:
            if tmp_path.exists():
                tmp_path.unlink(missing_ok=True)
            return None
    return h

workers = max(1, min(8, os.cpu_count() or 4))
print(f"Processing thumbnails using {workers} parallel workers...")

with ThreadPoolExecutor(max_workers=workers) as executor:
    list(executor.map(process_image, image_files))

if new_index_entries:
    with open(INDEX_FILE, "a", encoding="utf-8") as f:
        f.writelines(new_index_entries)

print("Pre-caching complete!")
